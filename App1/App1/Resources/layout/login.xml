<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:minWidth="25px"
    android:minHeight="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/linearLayout1"
    android:background="@drawable/bg4">

    <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_margin="5dp"
            android:layout_height="wrap_content">
    <Button
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:gravity="center"
        android:layout_gravity="top"
        android:layout_margin="8dp"
        android:id="@+id/btn_Home"
        android:backgroundTint="#114232"
        android:background="@drawable/ic_arrow_back_black_24"/>

        <TextView
            android:id="@+id/txtV_Admin"
            android:text="Admin Login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:textSize="13dp"
            android:layout_gravity="center"
            android:autoLink="none"
            android:textStyle="bold"
            android:textColor="#114232"/>

    </LinearLayout>
    
    <LinearLayout
        android:orientation="vertical"
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/linearLayout2"
        android:gravity="center">

       <TextView
            android:text="NutriTrack"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="40dp"
            android:gravity="center"
            android:id="@+id/txtV_Login"
            android:textColor="@android:color/background_light"
            android:textStyle="bold" />
         <TextView
            android:text=" A Personalized Tracking App"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:gravity="center"
            android:layout_marginBottom="10dp"
            android:id="@+id/txtV_Login1"
            android:textColor="@android:color/background_light"
           />

        <EditText
            android:inputType="textEmailAddress"
            android:layout_width="850px"
            android:layout_height="45dp"
            android:padding="5dp"
            android:layout_gravity="center"
            android:hint="Email"
            android:id="@+id/edtTxt_email"
            android:background="@drawable/login_inputbox_top"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />
        <EditText
            android:inputType="textPassword"
            android:layout_width="850px"
            android:layout_height="45dp"
            android:padding="5dp"
            android:layout_gravity="center"
            android:hint="Password"
            android:id="@+id/edtTxt_password"
            android:background="@drawable/login_inputbox_bottom"
            android:textStyle="bold" />
        <Button
            android:text="Log In"
            android:layout_width="650px"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_Login"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:textColor="@android:color/background_light"
            android:backgroundTint="#114232"
            android:background="@drawable/buttons" />
          <TextView
            android:text="Don't have an account?"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_width="650px"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15dp"
            android:layout_gravity="center"
            android:id="@+id/txtV_NoAcct"
            android:textColor="@android:color/background_light" />
        <TextView
            android:text="Click here!"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_width="650px"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15dp"
            android:layout_gravity="center"
            android:id="@+id/txtV_RegisterLink"
            android:autoLink="none"
            android:textStyle="bold"
            android:textColor="#114232" />
         <TextView
            android:text="Forgot Password?"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_width="650px"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15dp"
            android:layout_gravity="center"
            android:id="@+id/txtv_Forgotpass"
            android:autoLink="none"
            android:textStyle="bold"
            android:textColor="#114232" />
    

    </LinearLayout>
</LinearLayout>