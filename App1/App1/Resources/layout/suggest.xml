<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:minWidth="25px"
    android:minHeight="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/suggest"
    android:background="@android:color/holo_blue_dark">

    <TextView
        android:text="Suggested Foods"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/textV_Calorie_Track"
        android:textStyle="bold"
        android:textSize="20dp"
        android:textColor="@android:color/background_light"
        android:paddingLeft="20px"
        android:paddingTop="10px"
        android:paddingBottom="10px"
        
    />

    <LinearLayout
        android:orientation="vertical"
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/linearLayout_INNER"
        android:fadingEdge="none"
        android:background="#ff80d8ff">
        
        <TextView
            android:text="Health Restrictions"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="15dp"
            android:id="@+id/textV_healthill" />
       <ListView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/listview1"
            android:layout_weight ="1"/>

    </LinearLayout>

    <TextView
        android:text="Foods"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/textV_SugarTracker"
        android:textStyle="bold"
        android:textSize="20dp"
        android:textColor="@android:color/background_light"
        android:paddingLeft="20px"
        android:paddingTop="10px"
        android:paddingBottom="10px"
      
  />
    <LinearLayout
        android:orientation="vertical"
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/linearLayout2"
        android:background="#ff80d8ff">
       
        <ListView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/listview2"
            android:layout_weight ="1"/>
    </LinearLayout>

</LinearLayout>