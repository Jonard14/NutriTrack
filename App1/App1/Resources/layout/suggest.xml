<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:minWidth="25px"
    android:minHeight="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/suggest"
    android:background="@drawable/nutritrack">
    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/AppTheme.AppBarOverlay">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Layout Starts Here -->
    <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/layout_bg"
                android:layout_margin="5dp"
                android:padding="16dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_margin="3dp"
                    android:background="#114232"
                    android:src="@android:drawable/ic_dialog_info"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="long message text"
                    android:id="@+id/foods"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:paddingBottom="1dp" />
    </LinearLayout>

        

       <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        app:cardCornerRadius="10dp"
        android:backgroundTint="#114232"
        android:id="@+id/less_sugar_card"
        android:clickable="true"
        android:focusable="true">
       <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="1dp"
                android:background="@drawable/layout_bg">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:layout_margin="7dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/lesssug"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="Less Sugar"
                        android:textSize="16dp"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A diet focused on reducing the intake of sugary foods and beverages to improve overall health and prevent conditions  like diabetes and obesity."
                        android:textSize="10dp"
                        android:textColor="@android:color/darker_gray" />
                </LinearLayout>
          </LinearLayout>
          </androidx.cardview.widget.CardView>
         
          <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:backgroundTint="#114232"
        app:cardCornerRadius="10dp"
        android:id="@+id/high_prot_card"
        android:clickable="true"
        android:focusable="true">
         <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/layout_bg"
                android:layout_margin="1dp">

                <ImageView
                     android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:layout_margin="7dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/highprot"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High Protein "
                        android:textStyle="bold"
                        android:textSize="16dp"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A diet that emphasizes consuming higher amounts of protein-rich foods, such as meat, fish, eggs, and legumes, to support muscle growth and repair."
                        android:textSize="10dp"
                        android:textColor="@android:color/darker_gray" />
                </LinearLayout>
          </LinearLayout>
         </androidx.cardview.widget.CardView>

           <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:backgroundTint="#114232"
        android:id="@+id/less_sod_card"
        app:cardCornerRadius="10dp"
        android:clickable="true"
        android:focusable="true">
          <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/layout_bg"
                android:layout_margin="1dp">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:layout_margin="7dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/lesssod"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Less Sodium "
                        android:textStyle="bold"
                        android:textSize="16dp"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" A diet aimed at reducing sodium intake to help manage blood pressure and reduce the risk of heart disease."
                        android:textSize="10dp"
                        android:textColor="@android:color/darker_gray" />
                </LinearLayout>
          </LinearLayout>
        </androidx.cardview.widget.CardView>

         <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:backgroundTint="#114232"
        android:id="@+id/low_carb_card"
        android:clickable="true"
        app:cardCornerRadius="10dp"
        android:focusable="true">
          <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/layout_bg"
                android:layout_margin="1dp">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:scaleType="centerCrop"
                    android:layout_margin="7dp"
                    android:src="@drawable/lowcarb"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Low-Carb"
                        android:textStyle="bold"
                        android:textSize="16dp"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A diet that limits carbohydrate intake, often replacing them with higher amounts of protein and fat, to aid in weight loss and improve metabolic health."
                        android:textSize="10dp"
                        android:textColor="@android:color/darker_gray" />
                </LinearLayout>
          </LinearLayout>
        </androidx.cardview.widget.CardView>

         <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:id="@+id/low_fat_card"
        android:clickable="true"
        android:backgroundTint="#114232"
        app:cardCornerRadius="10dp"
        android:focusable="true">
           <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/layout_bg"
                android:layout_margin="1dp">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:scaleType="centerCrop"
                    android:layout_margin="7dp"
                    android:src="@drawable/lowfat"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Low-Fat Content"
                        android:textStyle="bold"
                        android:textSize="16dp"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A diet that restricts fat consumption, particularly saturated and trans fats, to promote heart health and support weight management."
                        android:textSize="10dp"
                        android:textColor="@android:color/darker_gray" />
                </LinearLayout>
          </LinearLayout>
        </androidx.cardview.widget.CardView>

         <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:id="@+id/less_chol_card"
        android:clickable="true"
        app:cardCornerRadius="10dp"
        android:backgroundTint="#114232"
        android:focusable="true">
           <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/layout_bg"
                android:layout_margin="1dp">

                <ImageView
                   android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:layout_margin="7dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/lesschol"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zero cholesterol"
                        android:textStyle="bold"
                        android:textSize="16dp"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A diet that eliminates cholesterol-rich foods, such as animal products, to reduce blood cholesterol levels and lower the risk of cardiovascular disease."
                        android:textSize="10dp"
                        android:textColor="@android:color/darker_gray" />
                </LinearLayout>
          </LinearLayout>
        </androidx.cardview.widget.CardView>
          

