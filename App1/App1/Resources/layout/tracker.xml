<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:minWidth="25px"
    android:minHeight="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/linearLayout1"
    android:background="@drawable/nutritrack">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/AppTheme.AppBarOverlay">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary" />

    </com.google.android.material.appbar.AppBarLayout>
     <View
            android:layout_width="350dp"
            android:layout_height="10dp"
            android:layout_gravity="center"/>
    

    <!-- Layout Starts Here -->
     <LinearLayout
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_margin="5dp"
                android:background="@drawable/layout_bg"
                android:layout_width="match_parent"
                android:layout_height="31dp"
                android:clickable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/linearLayout5">
                <TextView
                    android:text="Estimated Daily Calorie: "
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="50dp"
                    android:textColor="#000000"
                    android:textSize="18dp"
                    android:id="@+id/textV_PrevCalorie" />
                <TextView
                    android:text="0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:textColor="#000000"
                    android:textSize="20dp"
                    android:id="@+id/textV_NumPrev" />

            </LinearLayout>
    <View
            android:layout_width="350dp"
            android:layout_height="5dp"
            android:layout_gravity="center"/>
       
    <androidx.constraintlayout.widget.ConstraintLayout 
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" >
        <LinearLayout
            android:orientation="vertical"
            android:minWidth="25px"
            android:minHeight="25px"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


         <!-- Progress Bar for Calorie Count -->
        

    <!-- Doughnut chart starts here -->
      <androidx.constraintlayout.widget.ConstraintLayout 
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:background="@drawable/layout_bg"
        android:layout_margin="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" >
         
        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Calorie/Recommended Calorie"
            android:textStyle="bold"
            android:textSize="18dp"
            android:textColor="#000000"
            android:layout_marginBottom="155dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
         

        <!-- ProgressBar that represents a total of 100% -->
        <ProgressBar
            android:id="@+id/background_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/stats_full"
            android:layout_marginTop="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ProgressBar that represents a chart slice, where "android:progress" is the % value of the slice -->
        <ProgressBar
            android:id="@+id/stats_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="65"
            android:layout_marginTop="15dp"
            android:progressDrawable="@drawable/stats_progress"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

         <TextView
            android:id="@+id/number_of_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1500/2000"
            android:textColor="#000000"
            android:textSize="15dp"
            android:layout_marginTop="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- The text that goes in a center of the chart -->
     
    </androidx.constraintlayout.widget.ConstraintLayout >
    <!-- Doughnut chart ends here -->
              <View
            android:layout_width="350dp"
            android:layout_height="5dp"
            android:layout_gravity="center"/>

       <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/outerContainer" >


        <LinearLayout
            android:orientation="vertical"
            android:minWidth="25px"
            android:minHeight="25px"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:minWidth="25px"
            android:minHeight="25px"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:id="@+id/linearLayout_INNER"
            android:fadingEdge="none"
            android:background="@drawable/layout_bg"
            android:paddingTop="20px"
            android:paddingBottom="20px">

          
            <!-- Total Calorie Layout -->
            <LinearLayout
                android:orientation="horizontal"
                android:minWidth="25px"
                android:minHeight="25px"
                android:layout_margin="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/linearLayout8">
                <TextView
                    android:text="Total Sugar Consumed (g)"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20px"
                    android:id="@+id/textV_Sugar"
                    android:textStyle="bold"
                    android:textSize="18dp"/>
                <TextView
                    android:text="0"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/textV_NumSugar"
                    android:gravity="right"
                    android:textSize="18dp"
                    android:paddingRight="10px"/>
        
            </LinearLayout>
            <!-- Total Protein Layout -->
            <LinearLayout
                android:orientation="horizontal"
                android:minWidth="25px"
                android:minHeight="25px"
                android:layout_margin="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/linearLayout10">
                <TextView
                        android:text="Total Protein (g)"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="20px"
                        android:id="@+id/textV_protein"
                        android:textStyle="bold"
                        android:textSize="18dp"/>
                <TextView
                    android:text="0"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/textV_numprotein"
                    android:gravity="right"
                    android:textSize="18dp"
                    android:paddingRight="10px"/>
        
            </LinearLayout>
            <!-- Total Fat Layout -->
            <LinearLayout
                android:orientation="horizontal"
                android:minWidth="25px"
                android:minHeight="25px"
                android:layout_margin="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/linear1">
            <TextView
                    android:text="Total Fat (g)"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20px"
                    android:id="@+id/textV_fat"
                    android:textStyle="bold"
                    android:textSize="18dp"/>
            <TextView
                android:text="0"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textV_numfats"
                android:gravity="right"
                android:textSize="18dp"
                android:paddingRight="10px" />
        
            </LinearLayout>
            <!-- Total carbohydrates Layout -->
            <LinearLayout
                android:orientation="horizontal"
                android:minWidth="25px"
                android:minHeight="25px"
                android:layout_margin="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/linear2">
            <TextView
                    android:text="Total Carbohydrates (g)"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20px"
                    android:id="@+id/textV_carbohydrates"
                    android:textStyle="bold"
                    android:textSize="18dp"/>
            <TextView
                android:text="0"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textV_numcarbohydrates"
                android:gravity="right"
                android:textSize="18dp"
                android:paddingRight="10px" />
        
            </LinearLayout>
            <!-- Total sodium Layout -->
            <LinearLayout
                android:orientation="horizontal"
                android:minWidth="25px"
                android:minHeight="25px"
                android:layout_margin="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/linear3">
            <TextView
                    android:text="Total Sodium (mg)"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20px"
                    android:id="@+id/textV_sodium"
                    android:textStyle="bold"
                    android:textSize="18dp"/>
            <TextView
                android:text="0"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textV_numsodium"
                android:gravity="right"
                android:textSize="18dp"
                android:paddingRight="10px" />
        
            </LinearLayout>
            <!-- Total cholesterol Layout -->
            <LinearLayout
                android:orientation="horizontal"
                android:minWidth="25px"
                android:minHeight="25px"
                android:layout_margin="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/linear4">
            <TextView
                    android:text="Total Cholesterol (mg)"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20px"
                    android:id="@+id/textV_cholesterol"
                    android:textStyle="bold"
                    android:textSize="18dp"/>
            <TextView
                android:text="0"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textV_numcholesterol"
                android:gravity="right"
                android:textSize="18dp"
                android:paddingRight="10px"/>
        
            </LinearLayout>
            <View
            android:layout_width="350dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="#000000"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_margin="3dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center">
               
            <Button
                android:text="Save Calorie Intake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btn_saveCalorie"
                android:backgroundTint="#114232"/>

            <Button
                android:text="Reset All Values"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnn_resetSugar"
                android:backgroundTint="#114232"/>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </ScrollView>
   </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>