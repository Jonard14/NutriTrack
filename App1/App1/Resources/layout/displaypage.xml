<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:minWidth="25px"
    android:minHeight="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/linearLayout1"
    android:background="#87A922">

    <TextView
        android:text="Add Food"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/textV_Calorie_Track"
        android:textStyle="bold"
        android:textColor="@android:color/background_light"
        android:textSize="40dp"
        android:paddingLeft="20px"
        android:paddingTop="10px"
        android:paddingBottom="10px"/>

    <LinearLayout
        android:orientation="vertical"
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/linearLayout_INNER"
        android:fadingEdge="none"
        android:background="#F7F6BB">



        <TextView
            android:id="@+id/foodnameTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:gravity="start"
            android:layout_gravity="start"
            android:textSize="20dp"/>
        <TextView
            android:id="@+id/nutritionContentTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:gravity="start"
            android:layout_gravity="start"
            android:textSize="20dp"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btn_Add"
            android:layout_width="0dp"
            android:layout_height="120px"
            android:layout_weight="1"
            android:text="Add food"
            android:backgroundTint="#114232"/>

        <Button
            android:id="@+id/btn1"
            android:text="Go Back"
            android:layout_width="0dp"
            android:layout_height="120px"
            android:layout_weight="1"
            android:backgroundTint="#114232"/>

    </LinearLayout>
</LinearLayout>


