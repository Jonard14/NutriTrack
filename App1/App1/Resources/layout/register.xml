<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/outerContainer"
    android:background="#87A922" >


    <LinearLayout
        android:orientation="vertical"
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Email, First & Last name-->
        <Button
            android:text="Return Home"
            android:layout_width="450px"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="top"
            android:id="@+id/btn_Home"
            android:textStyle="bold"
            android:textColor="@android:color/background_light"
            android:backgroundTint="#114232"
            android:background="@drawable/buttons"/>

        <TextView
            android:text="Register"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="40dp"
            android:gravity="center"
            android:id="@+id/txtV_Register"
            android:textColor="@android:color/background_light"
            android:textStyle="bold" />


        <TextView
            android:text="Email:"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtV_Email"
            android:textColor="@android:color/background_light"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            android:paddingLeft="50px" />
        <EditText
            android:inputType="textEmailAddress"
            android:layout_width="1000px"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:hint="Email"
            android:id="@+id/edtTxt_Email"
            android:background="@drawable/register_inputbox_design"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="20dp"
            android:textStyle="bold" />

        <TextView
            android:text="First Name:"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtV_FirstName"
            android:textColor="@android:color/background_light"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            android:paddingLeft="50px" />
        <EditText
            android:inputType="text"
            android:layout_width="1000px"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:hint="First Name"
            android:id="@+id/edtTxt_FirstName"
            android:background="@drawable/register_inputbox_design"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="20dp"
            android:textStyle="bold" />

        <TextView
            android:text="Last Name:"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtV_LastName"
            android:textColor="@android:color/background_light"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            android:paddingLeft="50px" />
        <EditText
            android:inputType="text"
            android:layout_width="1000px"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:hint="Last Name"
            android:id="@+id/edtTxt_LastName"
            android:background="@drawable/register_inputbox_design"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="20dp"
            android:textStyle="bold" />

        <!-- Age & Gender -->
        <LinearLayout
            android:orientation="horizontal"
            android:minWidth="25px"
            android:minHeight="25px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:id="@+id/linearLayout1">

            <TextView
                android:text="Age:"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/txtV_Age"
                android:textColor="@android:color/background_light"
                android:textStyle="bold"
                android:paddingLeft="50px" />
            <EditText
                android:inputType="number"
                android:layout_width="200px"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:hint="Age"
                android:id="@+id/edtTxt_Age"
                android:background="@drawable/register_inputbox_design"
                android:layout_marginLeft="50dp"
                android:textStyle="bold" />

            <TextView
                android:text="Gender:"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/txtV_gender"
                android:textColor="@android:color/background_light"
                android:textStyle="bold"
                android:layout_marginLeft="15dp"
                android:paddingLeft="10px"
                android:textSize="20dp" />
            
            <Spinner
                android:padding="5dp"
                android:entries="@array/dropdown_gender"
                android:layout_width="200px"
                android:layout_height="match_parent"
                android:id="@+id/spinner_gender"
                android:layout_marginLeft="18dp"
                android:background="@drawable/register_inputbox_design"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Height & Weight -->
        <LinearLayout
            android:orientation="horizontal"
            android:minWidth="25px"
            android:minHeight="25px"
            android:layout_width="match_parent"
            android:layout_height="150px"
            android:layout_marginTop="20dp"
            android:id="@+id/linearLayout2">

            <TextView
                android:text="Height\n(meters):"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/txtV_Height"
                android:textColor="@android:color/background_light"
                android:textStyle="bold"
                android:paddingLeft="10px"
                android:gravity="right"
                android:layout_marginLeft="15dp"
                />
            <EditText
                android:inputType="numberDecimal"
                android:layout_width="200px"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="0"
                android:id="@+id/edtTxt_Height"
                android:background="@drawable/register_inputbox_design"
                android:layout_marginLeft="17dp"
                android:textStyle="bold" />


            <TextView
                android:text="Weight\n(kg):"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/txtV_Weight"
                android:textColor="@android:color/background_light"
                android:textStyle="bold"
                android:paddingLeft="20px"
                android:layout_marginLeft="25dp"
                android:gravity="right"/>
            <EditText
                android:inputType="numberDecimal"
                android:layout_width="200px"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="0"
                android:id="@+id/edtTxt_Weight"
                android:background="@drawable/register_inputbox_design"
                android:layout_marginLeft="19dp"
                android:textStyle="bold" />


        </LinearLayout>


        <!-- BMI -->
        <LinearLayout
            android:orientation="horizontal"
            android:minWidth="25px"
            android:minHeight="25px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:id="@+id/linearLayout3">

            <TextView
                android:text="BMI:"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/txtV_BMI"
                android:textColor="@android:color/background_light"
                android:textStyle="bold"
                android:paddingLeft="50px"
                android:gravity="right" />
            <EditText
                android:inputType="none"
                android:layout_width="200px"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="0"
                android:id="@+id/edtTxt_BMI"
                android:background="@drawable/register_inputbox_design"
                android:layout_marginLeft="50dp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false" />

        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:minWidth="25px"
            android:minHeight="25px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:id="@+id/linearLayout4">

            <TextView
                android:text="Illnesses:"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/txtV_ill"
                android:textColor="@android:color/background_light"
                android:textStyle="bold"
                android:paddingTop="20px"
                android:paddingLeft="40px"
                android:paddingRight="10px"
                android:gravity="right"
                />
            <!--
            <androidx.appcompat.widget.AppCompatSpinner
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/appCompatSpinner1"
                android:entries="@array/dropdown_gender" />
            -->
            <!--
            <Spinner
                android:padding="5dp"
                android:entries="@array/dropdown_illness"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/spinner_gender"
                android:layout_marginLeft="18dp"
                android:background="@android:color/white"
                android:textStyle="bold" />
            -->
            
            <CheckBox
                android:text="Heart Disease"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/checkBox1"
                android:textColor="@android:color/background_light"
                android:buttonTint="#F7F6BB"
                />

            <CheckBox
                android:text="Diabetes"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/checkBox2"
                android:textColor="@android:color/background_light"
                android:buttonTint="#F7F6BB"/>

            <CheckBox
                android:text="Cancer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/checkBox3"
                android:textColor="@android:color/background_light"
                android:buttonTint="#F7F6BB"/>
            
        </LinearLayout>


        <!-- Password -->
        <TextView
            android:text="Password:"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtV_Password"
            android:textColor="@android:color/background_light"
            android:textStyle="bold"
            android:paddingLeft="50px"
            android:layout_marginTop="15dp"
            />
        <EditText
            android:inputType="textPassword"
            android:layout_width="1000px"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:hint="Password"
            android:id="@+id/edtTxt_Password"
            android:background="@drawable/register_inputbox_design"
            android:layout_marginLeft="20dp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            />

        <TextView
            android:text="Re-type Password:"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtV_RePassword"
            android:textColor="@android:color/background_light"
            android:textStyle="bold"
            android:paddingLeft="50px"
            android:layout_marginTop="15dp"
            />
        <EditText
            android:inputType="textPassword"
            android:layout_width="1000px"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:hint="Re-type Password"
            android:id="@+id/edtTxt_RePassword"
            android:background="@drawable/register_inputbox_design"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="15dp"
            android:textStyle="bold" />


        <Button
            android:text="Register"
            android:layout_width="650px"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:id="@+id/btn_Register"
            android:textStyle="bold"
            android:textColor="@android:color/background_light"
            android:backgroundTint="#114232" 
            android:background="@drawable/buttons" />

    </LinearLayout>
</ScrollView>